{"id": "THG-F12", "baselineId": "codex-26.1007.30912-c5b273322a83", "claim": "The history registry is a WeakMap selected by qLt identity and contains entries, request ordering, redo invalidation order and transition tails. This source-scoped object is not proof of physical storage, cross-window identity or restart recovery.", "sourcePath": "app.asar/webview/assets/app-shared-8bd9d0399038.js", "sourceHash": "607ad0866dd25ed3764711b4467a9b60708353a599485b5249ff4cbe0e870245", "locator": {"byteRange": {"start": 2163818, "endExclusive": 2164003}, "spanHash": "932caf140310c20e8045a0c1e999821c484cf457c38f519a23adf9937c6e6024", "contractRef": {"path": "raw/tab-history-command-goals-v1/history-engine/source-contracts.json", "bytes": 4066814, "sha256": "289cb94e28eb5c115a6e01ed71bd65224f91aecab8f6718692e22304a317e612", "jsonPointer": "/selectedSourceUnits/54"}, "supportingContractRefs": [{"path": "raw/tab-history-command-goals-v1/history-engine/source-contracts.json", "bytes": 4066814, "sha256": "289cb94e28eb5c115a6e01ed71bd65224f91aecab8f6718692e22304a317e612", "jsonPointer": "/selectedBindings/14"}, {"path": "raw/tab-history-command-goals-v1/history-engine/source-contracts.json", "bytes": 4066814, "sha256": "289cb94e28eb5c115a6e01ed71bd65224f91aecab8f6718692e22304a317e612", "jsonPointer": "/selectedBindings/13"}]}, "sourceUnitId": "THG-SOURCE-011", "method": "frozen full-program AST and scoped declaration/reference review; no target code evaluation", "confidence": "confirmed", "verificationStatus": "static-source-only; runtime-not-observed"}
