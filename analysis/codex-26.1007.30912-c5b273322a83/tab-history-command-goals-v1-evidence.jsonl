{"id": "THG-F14", "baselineId": "codex-26.1007.30912-c5b273322a83", "claim": "QF settles a pending entry, cancels its pending timer, advances redo invalidation on committed/timed-out outcomes, recomputes redo visibility and resolves completion. Discard and timeout are distinct completion outcomes.", "sourcePath": "app.asar/webview/assets/app-shared-8bd9d0399038.js", "sourceHash": "607ad0866dd25ed3764711b4467a9b60708353a599485b5249ff4cbe0e870245", "locator": {"byteRange": {"start": 2163517, "endExclusive": 2163818}, "spanHash": "ad3156c02b21c2aa77b69d27c702166a0c25002e38b2322f1f745796b4346764", "contractRef": {"path": "raw/tab-history-command-goals-v1/history-engine/source-contracts.json", "bytes": 4066814, "sha256": "289cb94e28eb5c115a6e01ed71bd65224f91aecab8f6718692e22304a317e612", "jsonPointer": "/selectedSourceUnits/40"}}, "sourceUnitId": "THG-SOURCE-013", "method": "frozen full-program AST and scoped declaration/reference review; no target code evaluation", "confidence": "confirmed", "verificationStatus": "static-source-only; runtime-not-observed"}
{"id": "THG-F15", "baselineId": "codex-26.1007.30912-c5b273322a83", "claim": "Redo visibility excludes entries invalidated through the recorded request order and entries older than pending-action ordering. Invalidated redo entries are finalized and removed; visible redo IDs are sorted by request order.", "sourcePath": "app.asar/webview/assets/app-shared-8bd9d0399038.js", "sourceHash": "607ad0866dd25ed3764711b4467a9b60708353a599485b5249ff4cbe0e870245", "locator": {"byteRange": {"start": 2162770, "endExclusive": 2163223}, "spanHash": "c66897da916af258e76ef97b33c27749e579ec23bab5b4c731c8d146a212fb9e", "contractRef": {"path": "raw/tab-history-command-goals-v1/history-engine/source-contracts.json", "bytes": 4066814, "sha256": "289cb94e28eb5c115a6e01ed71bd65224f91aecab8f6718692e22304a317e612", "jsonPointer": "/selectedSourceUnits/35"}}, "sourceUnitId": "THG-SOURCE-014", "method": "frozen full-program AST and scoped declaration/reference review; no target code evaluation", "confidence": "confirmed", "verificationStatus": "static-source-only; runtime-not-observed"}
